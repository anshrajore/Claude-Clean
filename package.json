{
  "name": "claude-clean",
  "version": "1.1.0",
  "description": "Local CLI to detect and remove embedded Claude/AI watermark and attribution content from user-owned files.",
  "keywords": [
    "claude",
    "watermark",
    "attribution",
    "cli",
    "markdown",
    "html",
    "json"
  ],
  "license": "MIT",
  "author": "anshrajore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshrajore/Claude-Clean.git"
  },
  "bugs": {
    "url": "https://github.com/anshrajore/Claude-Clean/issues"
  },
  "homepage": "https://github.com/anshrajore/Claude-Clean#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "claude-clean": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "rules",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.0.2",
    "parse5": "^7.2.1",
    "picocolors": "^1.1.1",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
